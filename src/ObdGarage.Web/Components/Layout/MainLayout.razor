@inherits LayoutComponentBase
@* Unused directly - injecting it here forces SyncManager's (and its scoped AppState's)
   construction as early as possible in this circuit, before any routed page underneath
   this layout reads AppState.CurrentUserId. SyncManager's constructor loads whichever
   account was last saved to sync-auth.json, so a fresh tab still opens "logged in" exactly
   as before AppState/SyncManager became per-circuit instead of process-wide singletons. *@
@inject SyncManager Sync

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">Obd<span>Garage</span></a>
        <nav class="topnav">
            <a href="/">Garage</a>
            <a href="/settings">Einstellungen</a>
        </nav>
    </header>
    <main class="content">
        @Body
    </main>
    <footer class="footer">ObdGarage &mdash; OBD2-Fahrzeug-App</footer>
</div>
