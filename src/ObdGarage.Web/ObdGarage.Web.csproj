<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ObdGarage.Core\ObdGarage.Core.csproj" />
    <ProjectReference Include="..\ObdGarage.Application\ObdGarage.Application.csproj" />
    <ProjectReference Include="..\ObdGarage.Data\ObdGarage.Data.csproj" />
    <ProjectReference Include="..\ObdGarage.Obd\ObdGarage.Obd.csproj" />
    <ProjectReference Include="..\ObdGarage.UI\ObdGarage.UI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Implicit SDK package pinned explicitly so packages.lock.json stays valid across SDK
         patches (its implicit version follows the installed SDK); Dependabot bumps it. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.12" />
  </ItemGroup>

</Project>
