@inject IObdSampleStore Samples
@inject IClock Clock

<div class="card">
    <h3>Werte-Verlauf</h3>
    <div class="filter-bar">
        <label>Wert
            <select @bind="_pidKey">
                @foreach (var pid in _availablePids)
                {
                    <option value="@pid.Key">@pid.DisplayName (@pid.Unit)</option>
                }
            </select>
        </label>
        <label>Zeitraum
            <select @bind="_range">
                <option value="hour">Letzte Stunde</option>
                <option value="day">Letzter Tag</option>
                <option value="week">Letzte Woche</option>
                <option value="custom">Frei wählbar</option>
            </select>
        </label>
        <label>Von
            <input type="datetime-local" value="@_from" @onchange="e => _from = e.Value?.ToString()" />
        </label>
        <label>Bis
            <input type="datetime-local" value="@_to" @onchange="e => _to = e.Value?.ToString()" />
        </label>
        <button class="btn btn-primary" type="button" @onclick="Anzeigen">Anzeigen</button>
    </div>

    @if (_samples.Count == 0)
    {
        <p class="muted chart-empty">
            Keine Daten für „@(_selectedPid?.DisplayName ?? _pidKey)“ im gewählten Zeitraum.
            Verbinde das Fahrzeug (Tab „Dashboard“) — jeder gepollte Livewert wird automatisch historisiert.
        </p>
    }
    else
    {
        <div class="chart-wrap">
            @((MarkupString)SvgChart.Render(_samples, _selectedPid?.Unit ?? ""))
        </div>
        <div class="chart-stats muted small">
            @_samples.Count Datenpunkte
            &middot; Min @Stat(_samples.Min(s => s.MinValue ?? s.Value))
            &middot; Ø @Stat(_samples.Average(s => s.Value))
            &middot; Max @Stat(_samples.Max(s => s.MaxValue ?? s.Value))
            @if (_samples.Any(s => s.IsAggregated))
            {
                <span> &middot; enthält Minuten-Aggregate (Min/Max-Band)</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required CarApp.Core.Vehicle Vehicle { get; set; }
    [Parameter] public string? Pid { get; set; }
    [Parameter] public string? Range { get; set; }
    [Parameter] public string? From { get; set; }
    [Parameter] public string? To { get; set; }

    private IReadOnlyList<ObdSample> _samples = [];
    private List<PidDefinition> _availablePids = [];
    private PidDefinition? _selectedPid;
    private string _pidKey = "";
    private string _range = "hour";
    private string? _from;
    private string? _to;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
            return;
        _initialized = true;

        // Only offer PIDs that the vehicle supports according to the scan (fallback: all)
        _availablePids = Vehicle.SupportedPids.Count > 0
            ? StandardPids.All.Where(p => Vehicle.SupportedPids.Contains(p.Pid)).ToList()
            : StandardPids.All.ToList();
        if (_availablePids.Count == 0)
            _availablePids = StandardPids.All.ToList();

        _selectedPid = (Pid is not null ? StandardPids.ByKey(Pid) : null) ?? _availablePids[0];
        _pidKey = _selectedPid.Key;
        _range = Range is "day" or "week" or "custom" ? Range : "hour";
        _from = From;
        _to = To;

        await Load();
    }

    private async Task Anzeigen() => await Load();

    private async Task Load()
    {
        _selectedPid = StandardPids.ByKey(_pidKey) ?? _availablePids.FirstOrDefault();

        var now = Clock.UtcNow;
        var (from, to) = _range switch
        {
            "day" => (now.AddDays(-1), now),
            "week" => (now.AddDays(-7), now),
            "custom" => (Fmt.ParseDateTimeLocal(_from) ?? now.AddHours(-1),
                         Fmt.ParseDateTimeLocal(_to) ?? now),
            _ => (now.AddHours(-1), now),
        };

        _samples = await Samples.QueryAsync(Vehicle.Id, _pidKey, from, to);
    }

    private string Stat(double v) => v.ToString(Math.Abs(v) < 10 ? "N1" : "N0") +
        (_selectedPid is null ? "" : " " + _selectedPid.Unit);
}
