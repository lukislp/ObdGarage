<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CarApp.App.Components"
             x:Class="CarApp.App.MainPage">

    <!-- BlazorWebView hostet die Razor-UI; blazor.webview.js liefert MAUI selbst. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Main}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
