<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    .NET-MAUI-Blazor-Hybrid-Hülle (Plan 2.1). Baut NICHT in der Sandbox (kein
    maui-Workload, kein NuGet) — auf der Entwickler-Maschine reicht:
        dotnet workload install maui
        dotnet build src/CarApp.App -f net10.0-android
    Das Projekt ist bewusst NICHT in CarApp.slnx eingetragen, damit dotnet build/test
    der Solution ohne Workload weiter funktioniert. Zuhause hinzufügen mit:
        dotnet sln CarApp.slnx add src/CarApp.App/CarApp.App.csproj
    Details: docs/MAUI-SETUP.md
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CarApp.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Wie im Standard-MAUI-Blazor-Template: kein automatisches Scoped-CSS-Bundling. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>CarApp</ApplicationTitle>
    <ApplicationId>com.carapp.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App-Icon + Splash (einfache Platzhalter-SVGs, Resizetizer generiert alle Größen). -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon_fg.svg" Color="#1B2A4A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B2A4A" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Beide Pakete gehören zum Standard-MAUI-Blazor-Template und kommen beim Nutzer
      aus dem regulären NuGet-Feed; $(MauiVersion) setzt das installierte maui-Workload.
      Keine weiteren (Dritt-)Pakete — BLE später optional via Plugin.BLE (s. Services/BleTransport.cs).
    -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarApp.Core\CarApp.Core.csproj" />
    <ProjectReference Include="..\CarApp.Application\CarApp.Application.csproj" />
    <ProjectReference Include="..\CarApp.Data\CarApp.Data.csproj" />
    <ProjectReference Include="..\CarApp.Obd\CarApp.Obd.csproj" />
    <ProjectReference Include="..\CarApp.Shared\CarApp.Shared.csproj" />
  </ItemGroup>

</Project>
